---
interface Props {
  fullHeight?: boolean;
}

const { fullHeight = false } = Astro.props;
---

<div class={`forecasting-studio-root ${fullHeight ? 'full-studio' : ''}`}>
  <div class="studio-header">
    <div class="header-left">
      <div class="studio-badge">
        <span class="live-dot"></span> VIRTUAL TIME SERIES &amp; FORECASTING LAB
      </div>
      <h3 class="studio-title">Simulasi Real-Time &amp; Estimator Peramalan Beban</h3>
      <p class="studio-subtitle">Eksplorasi pembentukan beban sistem tenaga, pemfilteran derau sensor (Kalman Filter), dan peramalan multi-cakrawala (Holt-Winters &amp; SARIMA).</p>
    </div>
    <div class="header-actions">
      <button id="btn-export-csv" class="btn btn-sm btn-outline">
        <i data-lucide="download"></i> Export Data (.CSV)
      </button>
      <button id="btn-regenerate" class="btn btn-sm btn-primary">
        <i data-lucide="refresh-cw"></i> Acak Sinyal Baru
      </button>
    </div>
  </div>

  <div class="studio-grid">
    <!-- Left Control Panel -->
    <div class="studio-controls glass-panel">
      <div class="control-section-title">
        <i data-lucide="database"></i> 1. Sumber Data Sistem Tenaga
      </div>
      <div class="form-group">
        <label for="dataset-select">Pilih Karakteristik Sinyal:</label>
        <select id="dataset-select" class="custom-select">
          <option value="pln_load" selected>🏙️ Beban Puncak Harian PLN (MW)</option>
          <option value="solar_pv">☀️ Radiasi &amp; Daya PLTS 500 kWp (kW)</option>
          <option value="wind_power">💨 Daya Pembangkit Listrik Angin PLTB (kW)</option>
          <option value="transformer_temp">🌡️ Suhu Hotspot Transformator Gardu (°C)</option>
        </select>
      </div>

      <div class="form-group">
        <div class="label-row">
          <label for="slider-noise">Derau Sensor Pengukuran (Noise &sigma;):</label>
          <span id="val-noise" class="param-val">12 MW</span>
        </div>
        <input type="range" id="slider-noise" min="0" max="40" value="12" class="custom-slider" />
      </div>

      <div class="control-section-title" style="margin-top: 18px;">
        <i data-lucide="cpu"></i> 2. Model Algoritma Peramalan
      </div>
      <div class="form-group">
        <label for="model-select">Pilih Algoritma Estimator:</label>
        <select id="model-select" class="custom-select">
          <option value="kalman" selected>🔮 Discrete Kalman Filter (State-Space BLUE)</option>
          <option value="holt_winters">📈 Holt-Winters Triple Smoothing (Aditif/Multiplikatif)</option>
          <option value="sarima">📉 SARIMA(1,1,1)(1,1,0)[24] Box-Jenkins</option>
          <option value="lstm">🧠 Deep Recurrent LSTM Memory Emulator</option>
        </select>
      </div>

      <div class="form-group">
        <div class="label-row">
          <label for="slider-horizon">Horizon Peramalan ke Depan (h jam):</label>
          <span id="val-horizon" class="param-val">24 Jam</span>
        </div>
        <input type="range" id="slider-horizon" min="6" max="48" step="6" value="24" class="custom-slider" />
      </div>

      <!-- Dynamic Model Parameters -->
      <div id="kalman-params" class="model-param-group">
        <div class="form-group">
          <div class="label-row">
            <label for="slider-q">Kovarians Derau Proses (Q):</label>
            <span id="val-q" class="param-val">0.05</span>
          </div>
          <input type="range" id="slider-q" min="1" max="100" value="20" class="custom-slider" />
        </div>
        <div class="form-group">
          <div class="label-row">
            <label for="slider-r">Kovarians Derau Sensor (R):</label>
            <span id="val-r" class="param-val">2.5</span>
          </div>
          <input type="range" id="slider-r" min="1" max="100" value="25" class="custom-slider" />
        </div>
      </div>

      <div class="toggle-group">
        <label class="custom-checkbox">
          <input type="checkbox" id="toggle-confidence" checked />
          <span class="checkmark"></span>
          Tampilkan Pita Keyakinan (Confidence Interval 95%)
        </label>
      </div>

      <!-- Real-Time Metrics -->
      <div class="metrics-card">
        <div class="metrics-header">
          <i data-lucide="bar-chart-2"></i> METRIK EVALUASI AKURASI
        </div>
        <div class="metrics-grid">
          <div class="metric-box">
            <span class="m-label">RMSE</span>
            <span class="m-val" id="metric-rmse">0.00</span>
          </div>
          <div class="metric-box">
            <span class="m-label">MAE</span>
            <span class="m-val" id="metric-mae">0.00</span>
          </div>
          <div class="metric-box">
            <span class="m-label">MAPE</span>
            <span class="m-val" id="metric-mape">0.0%</span>
          </div>
          <div class="metric-box">
            <span class="m-label">R² SCORE</span>
            <span class="m-val" id="metric-r2">0.000</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Chart Container -->
    <div class="studio-chart-wrapper glass-panel">
      <div class="chart-top-bar">
        <div class="chart-legend-custom">
          <span class="legend-item"><span class="legend-dot dot-truth"></span> Target Asli (Ground Truth)</span>
          <span class="legend-item"><span class="legend-dot dot-sensor"></span> Sinyal Sensor Berderau</span>
          <span class="legend-item"><span class="legend-dot dot-forecast"></span> Estimasi &amp; Peramalan Model</span>
        </div>
        <div class="chart-status" id="chart-status-text">
          <i data-lucide="check-circle"></i> Estimator Real-Time Online
        </div>
      </div>
      
      <div class="chart-canvas-box">
        <canvas id="forecastingChart"></canvas>
      </div>
    </div>
  </div>
</div>

