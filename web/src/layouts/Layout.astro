---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Portal Perkuliahan & Virtual Laboratory Analisis Deret Waktu dan Peramalan Beban Sistem Tenaga Listrik - S1 Teknik Elektro Universitas Bengkulu."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Analisis Deret Waktu FT UNIB</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Navbar />

    <main class="page-content-wrapper">
      <slot />
    </main>

    <Footer />

    <script>
      import renderMathInElement from 'katex/dist/contrib/auto-render.mjs';
      import {
        createIcons,
        Activity,
        ArrowLeft,
        Award,
        BarChart2,
        BookMarked,
        BookOpen,
        Calendar,
        Check,
        CheckCircle,
        CheckCircle2,
        ChevronRight,
        ClipboardCheck,
        ClipboardList,
        Code,
        Copy,
        Cpu,
        Database,
        Download,
        DownloadCloud,
        FileBadge2,
        FileCheck,
        FileQuestion,
        FileText,
        Globe,
        Layers,
        List,
        PieChart,
        Presentation,
        RefreshCw,
        Search,
        ShieldCheck,
        Sigma,
        Target,
        Terminal,
        TrendingUp,
        UserCheck,
        Zap
      } from 'lucide';

      const icons = {
        Activity,
        ArrowLeft,
        Award,
        BarChart2,
        BookMarked,
        BookOpen,
        Calendar,
        Check,
        CheckCircle,
        CheckCircle2,
        ChevronRight,
        ClipboardCheck,
        ClipboardList,
        Code,
        Copy,
        Cpu,
        Database,
        Download,
        DownloadCloud,
        FileBadge2,
        FileCheck,
        FileQuestion,
        FileText,
        Globe,
        Layers,
        List,
        PieChart,
        Presentation,
        RefreshCw,
        Search,
        ShieldCheck,
        Sigma,
        Target,
        Terminal,
        TrendingUp,
        UserCheck,
        Zap
      };

      const initIcons = () => createIcons({ icons });

      // Expose local helper for dynamic client components (ForecastingStudio, Copy button)
      (window as any).lucide = { createIcons: initIcons };

      const initPageEnhancements = () => {
        initIcons();
        renderMathInElement(document.body, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '\\[', right: '\\]', display: true },
            { left: '\\(', right: '\\)', display: false }
          ],
          throwOnError: false
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPageEnhancements);
      } else {
        initPageEnhancements();
      }
    </script>
  </body>
</html>

<style>
  .page-content-wrapper {
    flex: 1;
    width: 100%;
  }
</style>
