---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Portal Perkuliahan & Virtual Laboratory Analisis Deret Waktu dan Peramalan Beban Sistem Tenaga Listrik - S1 Teknik Elektro Universitas Bengkulu."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Analisis Deret Waktu FT UNIB</title>
    <meta name="description" content={description} />
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- MathJax for LaTeX Equation Rendering -->
    <script>
      window.MathJax = {
        tex: {
          inlineMath: [['$', '$'], ['\\(', '\\)']],
          displayMath: [['$$', '$$'], ['\\[', '\\]']]
        },
        svg: { fontCache: 'global' }
      };
    </script>
    <script async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
  </head>
  <body>
    <Navbar />

    <main class="page-content-wrapper">
      <slot />
    </main>

    <Footer />

    <script>
      // Initialize Lucide Icons on every page
      declare const lucide: any;
      document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
        }
      });
    </script>
  </body>
</html>

<style>
  .page-content-wrapper {
    flex: 1;
    width: 100%;
  }
</style>
